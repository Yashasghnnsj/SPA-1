# Optional AbuseIPDB enrichment key. Leave blank to disable live lookups.
ABUSEIPDB_API_KEY=

# External DNS threat-event API. The URL is intentionally unset until supplied.
EVENT_API_URL=
API_SECRET=
EVENT_API_AUTH_HEADER=Authorization
EVENT_API_AUTH_SCHEME=Bearer
EVENT_API_INTERVAL_SECONDS=30
EVENT_API_ITEMS_PATH=data
EVENT_API_CURSOR_PATH=pagination.next_cursor
EVENT_API_CURSOR_PARAMETER=cursor
EVENT_API_STATE_FILE=data/event_api_cursor.json

# Host-run backend connection. Docker Compose overrides this with kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_INPUT_TOPIC=dns-threat-events
KAFKA_OUTPUT_TOPIC=dns-threat-events-scored
KAFKA_DEAD_LETTER_TOPIC=dns-threat-events-dead-letter
FLINK_REST_URL=http://localhost:8081
VITE_API_BASE_URL=http://localhost:8000
