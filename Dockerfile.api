FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-runtime.txt .
RUN pip install --no-cache-dir -r requirements-runtime.txt

COPY dns_inference_api.py threat_intel_service.py ./
COPY pipeline ./pipeline
COPY models/dns_detector_rf.joblib models/dns_model_metadata.json ./models/
RUN mkdir -p /app/data

EXPOSE 8000
CMD ["uvicorn", "dns_inference_api:app", "--host", "0.0.0.0", "--port", "8000"]
